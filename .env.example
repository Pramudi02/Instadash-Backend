# Email Service Configuration (Required for notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# MongoDB Configuration (Required)
# You can use MongoDB Atlas or any other MongoDB service
MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# JWT Configuration (Required for authentication)
# Generate a secure random string of at least 32 characters
JWT_SECRET_KEY=your-very-secure-jwt-secret-key-at-least-32-characters

# Development Configuration (Optional)
ASPNETCORE_ENVIRONMENT=Development
CORS_ORIGINS=http://localhost:4200,https://localhost:4200